# Marketing site (landingpage/) — guavajobs.com
# Copy to landingpage/.env.local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Product app (app/) — app.guavajobs.com
# Copy to app/.env.local (see also app/.env.example)
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# Postgres (Supabase) — required for Prisma in @guavajobs/core
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
