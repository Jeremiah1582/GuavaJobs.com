NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# Postgres (Supabase) — also set in packages/core for Prisma CLI
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Auth (browser) — from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy name still supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: account deletion from settings (not required for sign-in or db:seed)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Adzuna job board (https://developer.adzuna.com)
ADZUNA_APP_ID=your-app-id
ADZUNA_API_KEY=your-app-key

# AI cover letters (OpenAI)
OPENAI_API_KEY=sk-your-openai-key
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# AI cover letters (OpenAI)
OPENAI_API_KEY=your-openai-api-key
# Optional: OPENAI_MODEL=gpt-4o-mini

# OpenAI — AI cover letters (F9; server-only, set on App deploy)
OPENAI_API_KEY=sk-your-openai-key
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Dev seed (npm run db:seed from repo root)
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=your-dev-password
