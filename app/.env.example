NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# Postgres (Supabase) — also set in packages/core for Prisma CLI
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Auth (browser) — from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy name still supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: account deletion from settings (not required for sign-in or db:seed)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Adzuna job board (https://developer.adzuna.com)
ADZUNA_APP_ID=your-app-id
ADZUNA_API_KEY=your-app-key

# AI — cover letters + profile URL import (server-only; app/.env.local)
# OpenAI: key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
# OpenRouter: use OPENROUTER_API_KEY instead, or put sk-or-v1-… in OPENAI_API_KEY
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# Optional overrides:
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Dev seed (npm run db:seed from repo root)
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=your-dev-password
