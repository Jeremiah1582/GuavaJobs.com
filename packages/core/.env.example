# Prisma reads DATABASE_URL and DIRECT_URL from the Next.js app env file.
# Do not duplicate secrets here — use app/.env.local (see app/.env.example).
#
# Optional local override: symlink (Unix)
#   ln -sf ../../app/.env.local .env
#
# Recommended: run Prisma via package scripts (loads app/.env.local automatically):
#   pnpm --filter @guavajobs/core db:push
#   pnpm --filter @guavajobs/core db:generate
