{
  "name": "@guavajobs/core",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./api": "./src/api/index.ts",
    "./profile-url-import": "./src/services/profile-url-import/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma-with-app-env.mjs generate",
    "db:push": "node scripts/prisma-with-app-env.mjs db push",
    "db:migrate:dev": "node scripts/prisma-with-app-env.mjs migrate dev",
    "db:migrate:deploy": "node scripts/prisma-with-app-env.mjs migrate deploy",
    "db:migrate:status": "node scripts/prisma-with-app-env.mjs migrate status",
    "db:migrate:resolve": "node scripts/prisma-with-app-env.mjs migrate resolve",
    "db:studio": "node scripts/prisma-with-app-env.mjs studio",
    "db:seed": "node scripts/seed.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@supabase/supabase-js": "^2.49.8",
    "openai": "^4.104.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22",
    "prisma": "^6.9.0",
    "typescript": "^5"
  }
}
