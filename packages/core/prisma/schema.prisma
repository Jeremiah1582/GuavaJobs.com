generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserTier {
  FREEMIUM
  STARTER
  PRO
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  WAITING
  INTERVIEW
  OFFER
  ACCEPTED
}

enum ApplicationRejectionPhase {
  PRE_INTERVIEW
  POST_INTERVIEW
}

enum CoverLetterSource {
  MANUAL
  AI
}

enum JobCategory {
  ENGINEERING
  PRODUCT
  DESIGN
  DATA
  OTHER
  UNKNOWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  UNKNOWN
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  PROFESSIONAL
  FLUENT
  NATIVE
}

enum RightToWorkStatus {
  UK_CITIZEN
  SETTLED_STATUS
  PRE_SETTLED
  SKILLED_WORKER
  STUDENT_VISA
  NEEDS_SPONSORSHIP
  OTHER
  PREFER_NOT_TO_SAY
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum RelocationWillingness {
  NONE
  LOCAL
  NATIONAL
  INTERNATIONAL
}

enum SalaryPeriod {
  ANNUAL
  MONTHLY
  HOURLY
}

model User {
  id                     String    @id @default(uuid()) @db.Uuid
  email                  String    @unique
  displayName            String?
  tier                   UserTier  @default(FREEMIUM)
  aiLettersUsedThisMonth Int       @default(0)
  aiUsagePeriodStart     DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  profile          Profile?
  applications     Application[]
  savedJobSearches SavedJobSearch[]

  @@map("users")
}

model Profile {
  userId              String    @id @db.Uuid
  summary             String?
  headline            String?
  location            String?
  avatarUrl           String?
  phone               String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  region              String?
  postalCode          String?
  country             String?
  websiteUrl               String?
  linkedInUrl              String?
  githubUrl                String?
  aspiringRole             String?
  personalityType          String?
  languagesJson            Json?
  salaryCurrency           String?                @default("GBP")
  salaryMin                Int?
  salaryMax                Int?
  salaryPeriod             SalaryPeriod?          @default(ANNUAL)
  salaryNegotiable         Boolean                @default(false)
  rightToWork              RightToWorkStatus?
  rightToWorkNote          String?
  noticePeriodWeeks        Int?
  availableFrom            DateTime?
  targetSeniority          SeniorityLevel?
  employmentTypePreference EmploymentType?
  relocationWillingness    RelocationWillingness?
  experienceJson           Json?
  skills                   String[]               @default([])
  educationJson            Json?
  cvFileUrl                String?
  quizJson                 Json?
  lastImportedAt      DateTime?
  lastImportSourceUrl String?
  importMetaJson      Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Application {
  id                     String                     @id @default(uuid()) @db.Uuid
  userId                 String                     @db.Uuid
  status                 ApplicationStatus          @default(DRAFT)
  rejectionPhase         ApplicationRejectionPhase?
  rejectedAt             DateTime?
  company                String
  title                  String
  jobExternalId          String?
  jobUrl                 String?
  source                 String?
  location               String?
  salaryText             String?
  nextStep               String?
  contactName            String?
  viaRecruiter           Boolean                    @default(false)
  fitScore               String?
  industry               String?
  jobCategory            JobCategory                @default(UNKNOWN)
  jobCategoryOther       String?
  employmentType         EmploymentType             @default(UNKNOWN)
  requirementsNotes      String?                    @db.Text
  aboutNotes             String?                    @db.Text
  language               String?
  roleStartDate          DateTime?
  interviewRound         Int?
  interviewScheduledAt   DateTime?
  interviewLocation      String?
  interviewUrl           String?
  jobDescriptionSnapshot String?                    @db.Text
  jobListingSnapshot     Json?
  jobDescriptionText     String?                    @db.Text
  appliedAt              DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverLetters      CoverLetter[]
  timelineNotes     ApplicationNote[]
  profileSnapshot   ApplicationProfileSnapshot?

  @@unique([userId, jobExternalId])
  @@index([userId])
  @@map("applications")
}

model ApplicationProfileSnapshot {
  applicationId  String   @id @db.Uuid
  summary        String?  @db.Text
  experienceJson Json?
  skills         String[] @default([])
  educationJson  Json?
  snapshotAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_profile_snapshots")
}

model ApplicationNote {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @db.Uuid
  body          String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_notes")
}

model SavedJobSearch {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  label      String
  q          String?
  where      String?
  country    String   @default("gb")
  distanceKm Int?
  maxDaysOld Int?
  sortBy     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_job_searches")
}

model CoverLetter {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @db.Uuid
  content       String            @db.Text
  source        CoverLetterSource @default(MANUAL)
  citationsJson Json?             @map("citations_json")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId])
  @@map("cover_letters")
}
